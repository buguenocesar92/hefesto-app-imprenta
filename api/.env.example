# ---------------------------------------------------------------------------
# Variables de entorno de la API de Gestion de Imprenta
# ---------------------------------------------------------------------------
#
# NINGUN valor de este archivo es real. Los secretos se generan con:
#
#   openssl rand -base64 48                     # para APP_KEY
#   php artisan key:generate --show
#
# Las variables `IMPRENTA_*` son opcionales: si no se definen, se usan los
# valores por omision de `config/imprenta.php`.
# ---------------------------------------------------------------------------

APP_NAME="Imprenta Hefesto"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_WEB_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
# El rol de esta conexion NO puede ser superusuario ni tener BYPASSRLS.
# Con cualquiera de las dos, PostgreSQL ignora las politicas de Row Level
# Security y una imprenta podria ver los datos de otra. Lo comprueba:
#   php artisan imprenta:verificar-aislamiento
DB_CONNECTION=pgsql
DB_DATABASE=imprenta
DB_USERNAME=imprenta_app
DB_PASSWORD=
DB_HOST=postgres
DB_PORT=5432

# ---------------------------------------------------------------------------
# Rol de arranque de PostgreSQL
# ---------------------------------------------------------------------------
# El rol de arriba es el de la APLICACION, y lo crea el script de arranque
# `deploy/postgres/inicializar-rol.sh`. Este es el de ARRANQUE: la imagen
# oficial lo crea superusuario, asi que la aplicacion NUNCA conecta con el. Con
# superusuario, PostgreSQL ignora las politicas de Row Level Security y una
# imprenta podria ver los datos de otra. Los dos detalles, en docs/03.
#
# Es un secreto DISTINTO del de `DB_PASSWORD`: repetirlo deja el mismo
# superusuario y la misma contrasena en las dos conexiones.
DB_ADMIN_USERNAME=imprenta_admin
DB_ADMIN_PASSWORD=

# Solo en produccion: Redis exige contrasena.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=false

# ---------------------------------------------------------------------------
# Authentik (proveedor de identidad)
# ---------------------------------------------------------------------------
AUTHENTIK_ISSUER=https://id.ejemplo.cl/application/o/imprenta/
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_REDIRECT_URI=http://localhost:8000/api/v1/acceso/callback
AUTHENTIK_SCOPES=openid profile email
AUTHENTIK_ALGORITMO=RS256
AUTHENTIK_GRUPO_ADMIN=imprenta-administradores
AUTHENTIK_GRUPO_OPERADORES=imprenta-operadores

# ---------------------------------------------------------------------------
# Reglas de la imprenta (opcionales)
# ---------------------------------------------------------------------------
# Piezas de tolerancia por sobreentrega en la ultima plancha. Por omision 0:
# sin sobreentrega. Es la unica tolerancia que permite el sistema.
IMPRENTA_TOLERANCIA_PIEZAS=0

# Puntos porcentuales de diferencia entre la merma prevista y la realmente
# registrada para que el taller reciba un aviso. No bloquea nada.
IMPRENTA_MERMA_AVISO_PUNTOS=5

# Dias que se espera la respuesta del cliente a una prueba enviada. VENCIDO
# EL PLAZO EL PEDIDO SIGUE SIN APROBAR: el sistema nunca aprueba por silencio.
IMPRENTA_DIAS_PARA_VENCER_PRUEBA=5

# Dias de anticipacion con que se avisa de un pedido que se va a atrasar.
IMPRENTA_DIAS_AVISO_ATRASO=1

# Tamano maximo de un archivo de arte, en bytes. Solo de apoyo: el uploading
# real no lo hace esta aplicacion, el archivo vive fuera del sistema.
IMPRENTA_BYTES_MAXIMOS_ARTE=52428800
